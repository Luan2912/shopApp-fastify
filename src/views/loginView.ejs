<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đăng Nhập - BookNest</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    body {
      background: linear-gradient(to right, #f0f8ff, #e6f0ff);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .login-card {
      max-width: 420px;
      margin: auto;
      margin-top: 80px;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
      background-color: #ffffff;
    }

    .login-card .form-control {
      border-radius: 10px;
    }

    .login-card .btn-primary {
      border-radius: 10px;
    }

    .logo-text {
      font-size: 1.8rem;
      font-weight: bold;
      color: #0d6efd;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="#">
        <i class="fas fa-book me-2"></i> BookNest
      </a>
    </div>
  </nav>

  <!-- Login Card -->
  <div class="login-card">
    <div class="text-center mb-4">
      <i class="fas fa-user-circle fa-3x text-primary"></i>
      <h4 class="mt-2">Chào mừng bạn quay lại!</h4>
    </div>
    <form>
      <div class="mb-3">
        <label for="email" class="form-label">Địa chỉ Email</label>
        <input type="email" class="form-control" id="email" placeholder="example@gmail.com" required>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Mật khẩu</label>
        <input type="password" class="form-control" id="password" placeholder="••••••••" required>
      </div>
      <div class="d-flex justify-content-between mb-3">
        <div>
          <input type="checkbox" id="rememberMe">
          <label for="rememberMe" class="form-check-label ms-1">Ghi nhớ</label>
        </div>
        <a href="#" class="text-decoration-none text-primary">Quên mật khẩu?</a>
      </div>
      <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
    </form>

    <div class="text-center mt-4">
      <p>Bạn chưa có tài khoản? <a href="#" class="text-primary">Đăng ký ngay</a></p>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
