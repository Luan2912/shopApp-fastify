<link rel="stylesheet" href="/public/css/user.css"/>
<%- include('partials/navAdminView',{
    page: "Manage Users",
    action: '/user'
}) %>

    <div class="container">
        <div class="row">
            <h1 class="col-12 text-center">Manage User</h1>

            <div class="col-12">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Avatar</th>
                            <th scope="col">Username</th>
                            <th scope="col">Email</th>
                            <th scope="col">Age</th>
                            <th scope="col">Gender</th>
                            <th scope="col">Address</th>
                            <th scope="col">Role</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach((user, index) => { %>
                            <tr>
                                <td><%= (index + 1)+pagination.limit*(pagination.currentPage-1) %></td>
                                <td>
                                    <% if (user.avatarPath) { %>
                                        <img src="/public/<%= user.avatarPath %>" alt=""/>
                                    <% } else { %>
                                        <img src="/public/uploads/avatar-upload/default-avatar-profile.png" alt=""/>
                                    <% } %>
                                </td>
                                <td><%= user.username %></td>
                                <td><%= user.email %></td>
                                <td><%= user.age %></td>
                                <td><%= user.gender %></td>
                                <td><%= user.address %></td>
                                <td><%=user.role %></td>
                                <td>
                                    <a href="user/profile-user/<%= user._id %>?<%= new URLSearchParams(query).toString()%>" class="btn btn-warning">Profile</a>
                                    <form
                                        action="/user/delete-user/<%= user._id %>?<%= new URLSearchParams(query).toString() %>"
                                        method="POST"
                                        style="display: inline">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="wrapper-pagination">
                    <ul class="pagination">
                        <% if (pagination.prevPage) { %>
                            <li>
                                <a
                                    href="?<%= new URLSearchParams({ ...query, page: pagination.prevPage, limit: pagination.limit }).toString() %>">Prev</a>
                            </li>
                        <% } %>

                        <% if (pagination.currentPage > 3) { %>
                            <li>
                                <a
                                    href="?<%= new URLSearchParams({ ...query, page: 1, limit: pagination.limit }).toString() %>">1</a>
                            </li>
                            <% if (pagination.currentPage > 4) { %>
                                <li>
                                    <span>...</span></li>
                            <% } %>
                        <% } %>

                        <% for (let i = pagination.currentPage - 1; i <= pagination.currentPage + 1; i++) {
                if (i > 0 && i <= pagination.totalPage) { %>
                            <li class="<%= i === pagination.currentPage ? 'active' : '' %>">
                                <a
                                    href="?<%= new URLSearchParams({ ...query, page: i, limit: pagination.limit }).toString() %>"><%= i %></a>
                            </li>
                            <% }} %>

                                <% if (pagination.currentPage < pagination.totalPage - 2) { %>
                                    <% if (pagination.currentPage < pagination.totalPage - 3) { %>
                                        <li>
                                            <span>...</span></li>
                                    <% } %>
                                    <li>
                                        <a
                                            href="?<%= new URLSearchParams({ ...query, page: pagination.totalPage, limit: pagination.limit }).toString() %>"><%= pagination.totalPage %></a>
                                    </li>
                                <% } %>

                                <% if (pagination.nextPage) { %>
                                    <li>
                                        <a
                                            href="?<%= new URLSearchParams({ ...query, page: pagination.nextPage, limit: pagination.limit }).toString() %>">Next</a>
                                    </li>
                                <% } %>
                            </ul>

                            <div class="goto-page" style="margin-top: 20px; text-align: center;">
                                <form id="gotoForm" action="/user" method="get">
                                    <% for (let key in query) {
                                if (key !== 'page' && key !== 'limit') { %>
                                        <input type="hidden" name="<%= key %>" value="<%= query[key] %>">
                                        <% }} %>

                                            <label for="gotoPage">Trang:</label>
                                            <input class="input-gotoPage"
                                                type="number"
                                                id="gotoPage"
                                                name="page"
                                                min="1"
                                                max="<%= pagination.totalPage %>"
                                                value="<%= pagination.currentPage %>"
                                                required="required"><span>/<%= pagination.totalPage %></span>
                                            <input type="hidden" name="limit" value="<%= pagination.limit || 10 %>">
                                            <button type="submit">Đi</button>
                                        </form>

                                    </div>
                                </div>
                            </div>

                            <!-- Fix lỗi: /user/create-user? -->
                            <% const queryString = new URLSearchParams(query).toString(); %>
                                <% if (queryString === '') { %>
                                    <a
                                        class="btn btn-create-user btn-success"
                                        href="/user/create-user"
                                        role="button"
                                        title="Create New User">
                                        <i class="fa-solid fa-user-plus"></i>
                                    </a>
                                <% } else{ %>
                                    <a
                                        class="btn btn-create-user btn-success"
                                        href="/user/create-user?<%= new URLSearchParams(query).toString()%>"
                                        role="button"
                                        title="Create New User">
                                        <i class="fa-solid fa-user-plus"></i>
                                    </a>
                                <% } %>