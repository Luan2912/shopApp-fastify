<link rel="stylesheet" href="/public/css/user.css">
<%- include('partials/navAdminView') %>

    <div class="container">
        <div class="row">
            <h1 class="col-12 text-center">Manage User</h1>

            <div class="col-12">

                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Avatar</th>
                            <th scope="col">Username</th>
                            <th scope="col">Email</th>
                            <th scope="col">Age</th>
                            <th scope="col">Gender</th>
                            <th scope="col">Address</th>


                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach((user, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>

                                <td>
                                    <% if (user.avatarPath) { %>
                                        <img src="/public/<%= user.avatarPath %>" alt="">
                                    <% } else { %>
                                        <img src="/public/uploads/avatar-upload/default-avatar-profile.png" alt="">
                                    <% } %>
                                </td>

                                <td><%= user.username %></td>
                                <td><%= user.email %></td>
                                <td><%= user.age %></td>
                                <td><%= user.gender %></td>
                                <td><%= user.address %></td>
                                
                                <td>
                                    <a href="user/profile-user/<%= user._id %>" class="btn btn-warning">Profile</a>
                                    <form
                                        action="/user/delete-user/<%= user._id %>"
                                        method="POST"
                                        style="display:inline;">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </td>

                            </tr>
                            <% }); %>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

            <a
                class="btn btn-create-user btn-success"
                href="/user/create-user"
                role="button"
                title="Create New User">
                <i class="fa-solid fa-user-plus"></i>
            </a>