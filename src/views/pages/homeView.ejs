<!-- Bootstrap JS -->
<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="/public/css/home.css">

<%- include('partials/nav', { user }) %>

    <!-- HERO BANNER -->
    <section class="hero">
        <div class="container">
            <h1 class="display-5">Chào mừng đến với
                <strong>BookNest</strong>
            </h1>
            <p class="lead">Khám phá hàng ngàn đầu sách hay, giá tốt và giao hàng tận nơi!</p>
            <a href="#" class="btn btn-light btn-lg mt-3">Khám phá ngay</a>
        </div>
    </section>

    <!-- DANH SÁCH SÁCH -->
    <div class="container mt-5">
        <div class="row g-4">
            <% books.forEach(book => { %>
                <div class="col-12 col-md-4">
                    <div class="card book-card h-100 d-flex flex-column">
                        <img
                            src="/public<%= book.thumbnailProductPath %>"
                            class="card-img-top"
                            alt="<%= book.title %>">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title"><%= book.title %></h5>

                            <p class="card-text"><%= book.description.length > 160 ?
                                book.description.substring(0, 160) + '...' : book.description %></p>

                            <div class="row mt-auto">
                                <div class="col-md-4">
                                    <p class="book-price text-danger fw-bold"><%= book.price.toLocaleString() %>₫</p>
                                    <div
                                        class="book-status <%= book.status ? 'bg-success' : 'bg-danger' %> text-white rounded px-2 py-1 mb-2">
                                        <p class="mb-0"><%= book.status ? 'Còn hàng' : 'Hết hàng' %></p>
                                    </div>
                                    <a href="/product/<%= book._id %>" class="btn btn-primary btn-sm px-3">Xem chi tiết</a>
                                </div>
                                <div class="col-md-8">
                                    <p>
                                        <strong>Tác Giả:</strong>
                                        <%=book.author %></p>
                                    <p>
                                        <strong>NXB:</strong>
                                        <%=book.publisher %></p>
                                    
                                        <strong>Thể Loại:</strong>
                                        <% if (Array.isArray(book.categoryNames)) { %>
                                <% book.categoryNames.forEach(name => { %>
                                    <span class="badge bg-info text-dark"><%= name %></span>
                                    <% }) %>
                                    <% } else { %>
                                        <%= book.categoryName %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
                </div>


                <%- include('partials/footer') %>
            